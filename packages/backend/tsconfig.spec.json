{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../dist/out-tsc",
        "module": "commonjs",
        "target": "ES2021",
        "types": ["jest", "node"],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "esModuleInterop": true,
        "importHelpers": true,
        "noImplicitAny": false
    }, 
    "include": [
        "src/**/*.spec.ts",
        "src/**/*.d.ts",
        "src/test-setup.ts"
    ]
}